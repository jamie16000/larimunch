# ============================================================
# Environment variables — copy this file to `.env.local`
# (the real file, .env.local, is gitignored — never commit it!)
# ============================================================

# CallMeBot WhatsApp API key
# To get one:
#   1. On your phone, add +34 644 51 95 23 to your WhatsApp contacts
#      (call it something like "CallMeBot")
#   2. Open a WhatsApp chat with that contact
#   3. Send the exact message: I allow callmebot to send me messages
#   4. Wait up to a few minutes — the bot replies with your API key
#   5. Paste the key on the line below (no quotes, no spaces)
#   6. Save this file as .env.local (without the ".example")
#   7. Stop the dev server (Ctrl+C) and run `npm run dev` again
CALLMEBOT_API_KEY=
